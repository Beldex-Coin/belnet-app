<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of BelNet is backed up to the cloud or copied to a
     new device. App data includes the original (pre-VPN) IP/location and
     node choices, which must not leave the device, and a restored
     "onboarding seen" flag would also skip the first-launch onboarding. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
